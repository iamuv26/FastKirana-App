# ──────────────────────────────────────────────────────────
# FastKirana Mobile — Environment Variables
# ──────────────────────────────────────────────────────────
# On Vercel: paste these in Project Settings → Environment Variables
# Locally:    create .env with your values (gitignored)
# ──────────────────────────────────────────────────────────

# Backend API base URL (production)
# On Vercel: set this to https://www.fastkirana.in/api
# Locally:   dev server at http://localhost:3000/api
EXPO_PUBLIC_API_BASE_URL=https://www.fastkirana.in/api

# ── Legacy (webapp only, not needed by the mobile app) ──
# DATABASE_URL="postgresql://postgres:password@localhost:5432/fastkirana"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# ... (keep existing webapp vars below)
